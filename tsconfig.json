{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"types": ["vite/client", "spotify-web-playback-sdk"],
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src", "tools", "vite.config.ts"]
}
